{
	log default {
		exclude http.log.error
	}
}

{$SITE_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' https://{$API_DOMAIN}; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy web:8080
}

{$API_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy api:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}
