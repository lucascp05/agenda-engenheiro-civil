generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  CLIENTE
  ENGENHEIRO
  ADMIN
}

enum SituacaoProfissional {
  EM_ANALISE
  APROVADO
  REJEITADO
}

enum Situacao {
  RECEBIDO
  INFORMACOES
  MARCADO
  CONCLUIDO
}

model Conta {
  id      String   @id @default(uuid())
  nome    String
  celular String?  @unique
  email   String?  @unique
  hash    String
  papel   Papel    @default(CLIENTE)
  pedidos Pedido[]
  versaoSessao Int @default(0)
  trocarSenha Boolean @default(false)
  sessoes SessaoAcesso[]
  perfilProfissional PerfilProfissional? @relation("Solicitante")
  revisoesProfissionais PerfilProfissional[] @relation("Revisor")
}

model PerfilProfissional {
  contaId            String               @id
  conta              Conta                @relation("Solicitante", fields: [contaId], references: [id])
  nomeCompleto       String
  titulo             String
  creaUf             String
  registro           String
  autorizaPublicacao Boolean              @default(false)
  situacao           SituacaoProfissional @default(EM_ANALISE)
  criadoEm           DateTime             @default(now()) @db.Timestamptz(3)
  revisorId          String?
  revisor            Conta?               @relation("Revisor", fields: [revisorId], references: [id], onDelete: Restrict)
  revisadoEm         DateTime?            @db.Timestamptz(3)
  fonteOficial       String?
  metodoIdentidade   String?
}

model SessaoAcesso {
  id        String   @id @default(uuid())
  contaId   String
  conta     Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)
  expiraEm  DateTime @db.Timestamptz(3)

  @@index([contaId])
  @@index([expiraEm])
}

model Pedido {
  id          String   @id @default(uuid())
  clienteId   String
  cliente     Conta    @relation(fields: [clienteId], references: [id])
  servico     String
  municipio   String
  comunidade  String?
  local       String
  celular     String?
  descricao   String
  link        String?
  situacao    Situacao @default(RECEBIDO)
  criadoEm    DateTime @default(now()) @db.Timestamptz(3)
  mensagens   Mensagem[]
  visita      Visita?

  @@index([clienteId, criadoEm])
}

model Mensagem {
  id       String   @id @default(uuid())
  pedidoId String
  pedido   Pedido   @relation(fields: [pedidoId], references: [id])
  autor    Papel
  texto    String
  criadoEm DateTime @default(now()) @db.Timestamptz(3)

  @@index([pedidoId, criadoEm])
}

model Visita {
  id       String   @id @default(uuid())
  pedidoId String   @unique
  pedido   Pedido   @relation(fields: [pedidoId], references: [id])
  horario  DateTime @unique @db.Timestamptz(3)
}

enum FinalidadeEmail {
  CADASTRO
  VINCULO
  RECUPERACAO
  PROPRIETARIO
}

model TokenEmail {
  hash       String @id
  finalidade FinalidadeEmail
  email      String
  nome       String?
  contaId    String?
  versao     Int?
  expiraEm   DateTime @db.Timestamptz(3)

  @@index([expiraEm])
}
